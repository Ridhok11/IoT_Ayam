/* =========================================
   SMART POULTRY HOUSE - DASHBOARD
   ========================================= */

.dashboard-grid,
.dashboard-columns {
    width: 100%;
    min-width: 0;
}

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 24px;
}

.sensor-card {
    position: relative;
    min-width: 0;
    padding: 24px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e5eaf0;
    border-radius: 18px;
    box-shadow: 0 5px 18px rgba(15, 35, 55, 0.045);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.sensor-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(15, 35, 55, 0.09);
}

.sensor-card::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 4px;
    content: "";
    background: #087f5b;
    opacity: 0.85;
}

.sensor-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #52647a;
    font-size: 14px;
    font-weight: 600;
}

.sensor-icon {
    display: flex;
    flex: 0 0 48px;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 15px;
    font-size: 23px;
}

.sensor-icon.temperature {
    background: #dcfce7;
}

.sensor-icon.humidity {
    background: #dbeafe;
}

.sensor-icon.relay {
    background: #fef3c7;
}

.sensor-icon.mode {
    background: #e8edf3;
}

.sensor-value {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 23px;
    color: #142337;
    font-size: clamp(25px, 2vw, 35px);
    font-weight: 750;
    letter-spacing: -1px;
    line-height: 1.2;
    overflow-wrap: anywhere;
}

.sensor-value small {
    color: #64748b;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0;
}

.sensor-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 17px;
    color: #64748b;
    font-size: 12px;
    line-height: 1.5;
}

.sensor-footer::before {
    flex: 0 0 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    content: "";
}

.dashboard-columns {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(280px, 1fr);
    align-items: start;
    gap: 22px;
}

.panel {
    min-width: 0;
    padding: 24px;
    background: #ffffff;
    border: 1px solid #e5eaf0;
    border-radius: 18px;
    box-shadow: 0 5px 18px rgba(15, 35, 55, 0.045);
}

.panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 24px;
}

.panel-header h2 {
    margin: 0;
    color: #142337;
    font-size: 18px;
    font-weight: 750;
    line-height: 1.4;
}

.panel-header p {
    margin: 6px 0 0;
    color: #718096;
    font-size: 13px;
    line-height: 1.5;
}

.live-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    color: #087f5b;
    background: #dcfce7;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
}

.chart-container {
    position: relative;
    width: 100%;
    height: 320px;
    min-width: 0;
}

.chart-container canvas {
    display: block;
    width: 100% !important;
    max-width: 100%;
}

@media (min-width: 1500px) {
    .sensor-card {
        padding: 27px;
    }

    .chart-container {
        height: 360px;
    }
}

@media (max-width: 1200px) {
    .dashboard-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-columns {
        grid-template-columns: minmax(0, 1fr);
    }

    .chart-container {
        height: 320px;
    }
}

@media (max-width: 600px) {
    .dashboard-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 14px;
        margin-bottom: 16px;
    }

    .sensor-card {
        padding: 20px;
        border-radius: 15px;
    }

    .sensor-value {
        margin-top: 18px;
        font-size: 29px;
    }

    .dashboard-columns {
        gap: 16px;
    }

    .panel {
        padding: 17px;
        border-radius: 15px;
    }

    .panel-header {
        margin-bottom: 18px;
    }

    .panel-header h2 {
        font-size: 16px;
    }

    .chart-container {
        height: 270px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .sensor-card {
        transition: none;
    }
}

/* =========================================
   SYSTEM STATUS
   ========================================= */

.status-list {
    display: flex;
    flex-direction: column;
    width: 100%;
}

.status-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-width: 0;
    padding: 16px 0;
    border-bottom: 1px solid #edf1f5;
    color: #52647a;
    font-size: 13px;
}

.status-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.status-item > span {
    flex: 1;
    min-width: 0;
}

.status-item strong {
    color: #142337;
    font-size: 13px;
    font-weight: 700;
    text-align: right;
    overflow-wrap: anywhere;
}

#deviceStatus,
#sensorStatus,
#deviceRelay {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 11px;
    border-radius: 20px;
    background: #f1f5f9;
    color: #475569;
    font-size: 11px;
    white-space: nowrap;
}

#deviceStatus.online,
#sensorStatus.active,
#deviceRelay.on {
    background: #dcfce7;
    color: #087f5b;
}

#deviceStatus.offline,
#sensorStatus.inactive,
#deviceRelay.off {
    background: #fee2e2;
    color: #b91c1c;
}

/* =========================================
   QUICK CONTROL
   ========================================= */

.quick-control {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 22px;
    padding: 20px;
    background: #f8fafc;
    border: 1px solid #e5eaf0;
    border-radius: 14px;
}

.quick-control > div:first-child {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.quick-control > div:first-child span {
    color: #142337;
    font-size: 15px;
    font-weight: 700;
}

.quick-control small {
    color: #718096;
    font-size: 12px;
}

.control-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.control-buttons .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-width: 105px;
    min-height: 42px;
    padding: 10px 18px;
    border: 1px solid transparent;
    border-radius: 10px;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.15s ease, filter 0.15s ease;
}

.control-buttons .btn:hover {
    filter: brightness(0.96);
    transform: translateY(-1px);
}

.control-buttons .btn:focus-visible {
    outline: 3px solid #93c5fd;
    outline-offset: 3px;
}

.control-buttons .btn-success {
    background: #087f5b;
    color: #ffffff;
}

.control-buttons .btn-danger {
    background: #ffffff;
    color: #b91c1c;
    border-color: #fecaca;
}

/* =========================================
   RESPONSIVE
   ========================================= */

@media (max-width: 600px) {
    .status-item {
        gap: 10px;
        padding: 14px 0;
        font-size: 12px;
    }

    .status-item strong {
        font-size: 12px;
    }

    .quick-control {
        align-items: stretch;
        padding: 16px;
    }

    .control-buttons {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .control-buttons .btn {
        min-width: 0;
        width: 100%;
        padding: 10px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .control-buttons .btn {
        transition: none;
    }
}
