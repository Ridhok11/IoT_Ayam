/* ======================================================
   SMART POULTRY HOUSE
   Modern Farm Dashboard — Light & Dark Theme
   Frontend only. Backend tidak diubah.
====================================================== */

:root {
    color-scheme: light;

    --farm-bg: #f6f7ef;
    --farm-surface: #ffffff;
    --farm-surface-alt: #f0f5e9;
    --farm-text: #233629;
    --farm-muted: #748174;
    --farm-border: #e2e9dc;

    --farm-green: #34764b;
    --farm-green-dark: #245638;
    --farm-green-soft: #e5f2e5;

    --farm-yellow: #f3c95b;
    --farm-yellow-soft: #fff5d7;

    --farm-red: #cf5650;
    --farm-blue: #4c83bd;

    --farm-radius: 18px;
    --farm-shadow: 0 8px 28px rgba(39, 67, 43, .07);
}

/* ---------- GLOBAL ---------- */

html {
    background: var(--farm-bg);
    scroll-behavior: smooth;
}

body {
    color: var(--farm-text) !important;
    background: var(--farm-bg) !important;
    transition: background .25s ease, color .25s ease;
}

::selection {
    color: #ffffff;
    background: var(--farm-green);
}

a {
    transition: color .2s ease, background .2s ease;
}

button,
input,
select,
textarea {
    border-radius: 10px;
}

/* ---------- SIDEBAR ---------- */

.sidebar {
    color: #edf5e9 !important;
    background:
        radial-gradient(ellipse at top left, #315f3d 0%, transparent 48%),
        linear-gradient(180deg, #1d3828 0%, #14281d 100%) !important;
    border-right: 1px solid rgba(255,255,255,.07) !important;
    box-shadow: 8px 0 30px rgba(25, 45, 29, .07);
}

.brand {
    min-height: 100px;
    border-bottom-color: rgba(255,255,255,.1) !important;
}

.brand-icon {
    background: linear-gradient(135deg, #f4d36f, #e7ad3e) !important;
    box-shadow: 0 6px 18px rgba(231,173,62,.2) !important;
}

.brand-text strong {
    color: #ffffff !important;
    letter-spacing: -.4px;
}

.brand-text span {
    color: #b8cbb9 !important;
}

.sidebar-section-label {
    color: #9db49e !important;
    letter-spacing: 1.4px;
}

.sidebar-menu a {
    margin: 2px 0;
    border-radius: 12px;
    color: #c8d8c9 !important;
    transition: background .2s ease, transform .2s ease;
}

.sidebar-menu a:hover {
    color: #ffffff !important;
    background: rgba(255,255,255,.08) !important;
    transform: translateX(2px);
}

.sidebar-menu a.active {
    color: #ffffff !important;
    background: linear-gradient(100deg, #39794c, #2d6740) !important;
    box-shadow: inset 3px 0 #f4d36f, 0 5px 14px rgba(0,0,0,.1);
}

.menu-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 25px;
}

.menu-divider {
    border-color: rgba(255,255,255,.1) !important;
}

.sidebar-device-card {
    background: rgba(255,255,255,.055) !important;
    border: 1px solid rgba(255,255,255,.11) !important;
    border-radius: 14px !important;
}

.sidebar-version {
    color: #9db49e !important;
}

/* ---------- TOP BAR ---------- */

.topbar {
    background: var(--farm-surface) !important;
    border-bottom: 1px solid var(--farm-border) !important;
}

.breadcrumb {
    color: var(--farm-muted) !important;
}

.breadcrumb-separator {
    color: #a6b3a2 !important;
}

.page-heading h1,
.topbar h1 {
    color: var(--farm-text) !important;
    letter-spacing: -.8px;
}

.page-heading p,
.topbar p {
    color: var(--farm-muted) !important;
}

.system-status,
.user-profile {
    border-color: var(--farm-border) !important;
}

.user-avatar {
    color: #ffffff !important;
    background: var(--farm-green) !important;
}

/* ---------- PAGE BACKGROUND ---------- */

.main-content {
    background: var(--farm-bg) !important;
}

.content {
    position: relative;
    isolation: isolate;
}

.content::before {
    position: absolute;
    top: 10px;
    right: 24px;
    z-index: -1;
    content: "🌿";
    font-size: 42px;
    opacity: .13;
    pointer-events: none;
}

/* ---------- DASHBOARD SENSOR CARDS ---------- */

.dashboard-grid {
    gap: 18px !important;
}

.sensor-card {
    position: relative;
    overflow: hidden;
    color: var(--farm-text) !important;
    background: var(--farm-surface) !important;
    border: 1px solid var(--farm-border) !important;
    border-radius: var(--farm-radius) !important;
    box-shadow: var(--farm-shadow) !important;
    transition: transform .2s ease, box-shadow .2s ease !important;
}

.sensor-card::before {
    position: absolute;
    top: 0;
    right: 0;
    width: 76px;
    height: 76px;
    content: "";
    background: var(--farm-green-soft);
    border-radius: 0 0 0 76px;
    opacity: .65;
    pointer-events: none;
}

.sensor-card::after {
    height: 4px !important;
    background: var(--farm-green) !important;
}

.sensor-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(39,67,43,.12) !important;
}

.sensor-card-header {
    position: relative;
    z-index: 1;
    color: var(--farm-muted) !important;
    font-weight: 650 !important;
}

.sensor-icon {
    position: relative;
    z-index: 1;
    border-radius: 14px !important;
}

.sensor-icon.temperature {
    background: #fce8df !important;
}

.sensor-icon.humidity {
    background: #dfeefb !important;
}

.sensor-icon.relay {
    background: var(--farm-yellow-soft) !important;
}

.sensor-icon.mode {
    background: var(--farm-green-soft) !important;
}

.sensor-value {
    position: relative;
    z-index: 1;
    color: var(--farm-text) !important;
    font-variant-numeric: tabular-nums;
}

.sensor-value small {
    color: var(--farm-muted) !important;
}

.sensor-footer {
    position: relative;
    z-index: 1;
    color: var(--farm-muted) !important;
}

/* ---------- PANELS AND CHART ---------- */

.panel,
.card,
.stat-card,
.content-card,
.dashboard-card,
.status-card,
.table-container,
.modal-content,
.dropdown-menu {
    color: var(--farm-text);
    background: var(--farm-surface);
    border: 1px solid var(--farm-border);
    border-radius: var(--farm-radius);
    box-shadow: var(--farm-shadow);
}

.panel {
    padding: 24px;
}

.panel-header h2,
.panel h2,
.panel h3 {
    color: var(--farm-text) !important;
}

.panel-header p,
.panel p {
    color: var(--farm-muted);
}

.live-badge {
    color: var(--farm-green-dark) !important;
    background: var(--farm-green-soft) !important;
    border: 1px solid #d3e7d0;
    border-radius: 30px !important;
}

.chart-container {
    border-radius: 12px;
}

/* ---------- TABLES ---------- */

table {
    width: 100%;
    border-collapse: collapse;
}

th {
    color: var(--farm-green-dark);
    background: var(--farm-surface-alt);
    font-weight: 700;
}

th,
td {
    border-color: var(--farm-border) !important;
}

tbody tr {
    transition: background .15s ease;
}

tbody tr:hover {
    background: var(--farm-surface-alt);
}

/* ---------- FORMS ---------- */

input,
select,
textarea {
    max-width: 100%;
    color: var(--farm-text);
    background: var(--farm-surface);
    border: 1px solid var(--farm-border);
    transition: border-color .2s ease, box-shadow .2s ease;
}

input:focus,
select:focus,
textarea:focus {
    outline: none;
    border-color: var(--farm-green);
    box-shadow: 0 0 0 3px rgba(52,118,75,.13);
}

button,
.btn,
button[type="submit"],
input[type="submit"] {
    transition: transform .15s ease, filter .15s ease;
}

button:hover,
.btn:hover,
button[type="submit"]:hover,
input[type="submit"]:hover {
    filter: brightness(.97);
}

button:active,
.btn:active {
    transform: scale(.98);
}

/* ---------- FOOTER ---------- */

.main-footer {
    color: var(--farm-muted) !important;
    border-top: 1px solid var(--farm-border) !important;
}

/* ---------- THEME TOGGLE ---------- */

.theme-toggle {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: calc(100% - 24px);
    min-height: 44px;
    margin: 12px;
    padding: 10px 12px;
    color: #f1f7ed !important;
    background: rgba(255,255,255,.07) !important;
    border: 1px solid rgba(255,255,255,.16) !important;
    border-radius: 12px !important;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
}

.theme-toggle:hover {
    background: rgba(255,255,255,.13) !important;
}

.theme-toggle-label {
    font-weight: 700;
}

.theme-toggle-state {
    color: #d5e4d4;
    font-size: 12px;
}

/* ---------- DARK THEME ---------- */

html[data-theme="dark"] {
    color-scheme: dark;

    --farm-bg: #111a15;
    --farm-surface: #1a2720;
    --farm-surface-alt: #223329;
    --farm-text: #edf4e9;
    --farm-muted: #a7b7a7;
    --farm-border: #304337;

    --farm-green: #70bb7c;
    --farm-green-dark: #a8d7a9;
    --farm-green-soft: #263f2d;

    --farm-yellow: #f3ce72;
    --farm-yellow-soft: #443a22;

    --farm-shadow: 0 8px 28px rgba(0,0,0,.16);
}

html[data-theme="dark"] body,
html[data-theme="dark"] .main-content {
    color: var(--farm-text) !important;
    background: var(--farm-bg) !important;
}

html[data-theme="dark"] .topbar,
html[data-theme="dark"] .sensor-card,
html[data-theme="dark"] .panel,
html[data-theme="dark"] .card,
html[data-theme="dark"] .stat-card,
html[data-theme="dark"] .content-card,
html[data-theme="dark"] .dashboard-card,
html[data-theme="dark"] .status-card,
html[data-theme="dark"] .table-container,
html[data-theme="dark"] .modal-content,
html[data-theme="dark"] .dropdown-menu {
    color: var(--farm-text) !important;
    background: var(--farm-surface) !important;
    border-color: var(--farm-border) !important;
    box-shadow: var(--farm-shadow) !important;
}

html[data-theme="dark"] .page-heading h1,
html[data-theme="dark"] .topbar h1,
html[data-theme="dark"] .sensor-value,
html[data-theme="dark"] .panel-header h2,
html[data-theme="dark"] .panel h2,
html[data-theme="dark"] .panel h3,
html[data-theme="dark"] label,
html[data-theme="dark"] td {
    color: var(--farm-text) !important;
}

html[data-theme="dark"] .page-heading p,
html[data-theme="dark"] .topbar p,
html[data-theme="dark"] .panel p,
html[data-theme="dark"] .sensor-card-header,
html[data-theme="dark"] .sensor-footer,
html[data-theme="dark"] .sensor-value small {
    color: var(--farm-muted) !important;
}

html[data-theme="dark"] .sensor-icon.temperature {
    background: #4b302a !important;
}

html[data-theme="dark"] .sensor-icon.humidity {
    background: #253c50 !important;
}

html[data-theme="dark"] .sensor-icon.relay {
    background: var(--farm-yellow-soft) !important;
}

html[data-theme="dark"] .sensor-icon.mode {
    background: var(--farm-green-soft) !important;
}

html[data-theme="dark"] .live-badge {
    color: #b8e8bc !important;
    background: #263f2d !important;
    border-color: #3c5b40 !important;
}

html[data-theme="dark"] th {
    color: var(--farm-text) !important;
    background: var(--farm-surface-alt) !important;
}

html[data-theme="dark"] tbody tr:hover {
    background: var(--farm-surface-alt) !important;
}

html[data-theme="dark"] input,
html[data-theme="dark"] select,
html[data-theme="dark"] textarea {
    color: var(--farm-text) !important;
    background: #111c15 !important;
    border-color: var(--farm-border) !important;
}

html[data-theme="dark"] input::placeholder,
html[data-theme="dark"] textarea::placeholder {
    color: #829586;
}

html[data-theme="dark"] .system-status,
html[data-theme="dark"] .user-profile {
    color: var(--farm-text);
    border-color: var(--farm-border) !important;
}

html[data-theme="dark"] .main-footer {
    color: var(--farm-muted) !important;
    border-color: var(--farm-border) !important;
}

/* ---------- RESPONSIVE ---------- */

@media (max-width: 900px) {
    .content {
        padding: 22px 18px;
    }

    .dashboard-grid {
        gap: 14px !important;
    }

    .panel {
        padding: 20px;
    }
}

@media (max-width: 600px) {
    .content {
        padding: 16px 12px;
    }

    .dashboard-grid {
        grid-template-columns: minmax(0, 1fr) !important;
        gap: 14px !important;
    }

    .sensor-card {
        padding: 20px !important;
    }

    .panel {
        padding: 16px !important;
        border-radius: 15px !important;
    }

    .content::before {
        right: 10px;
        font-size: 30px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: .01ms !important;
    }
}
