:root{--farm-bg:#f3f8ff;--farm-surface:#fff;--farm-text:#132d55;--farm-muted:#6880a2;--farm-border:#dce9fb;--farm-shadow:0 8px 24px rgba(23,74,132,.08)}
html[data-theme="light"] body{background:var(--farm-bg)!important;color:var(--farm-text)}
html[data-theme="light"] .card,html[data-theme="light"] .stat-card,html[data-theme="light"] .content-card,html[data-theme="light"] .dashboard-card,html[data-theme="light"] .chart-container,html[data-theme="light"] .status-card{border-color:var(--farm-border)!important;box-shadow:var(--farm-shadow)}
html[data-theme="light"] body::before{content:"🐔  •  🥚  •  🌿";position:fixed;right:22px;bottom:12px;z-index:0;opacity:.12;font-size:26px;pointer-events:none}
html[data-theme="dark"]{color-scheme:dark;--farm-bg:#07172c;--farm-surface:#0c2341;--farm-text:#e7f1ff;--farm-muted:#9bb5d7;--farm-border:#1e426d;--farm-shadow:0 8px 26px rgba(0,0,0,.22)}
html[data-theme="dark"] body{background:radial-gradient(ellipse at top right,#12345a 0,#07172c 55%)!important;color:var(--farm-text)!important}
html[data-theme="dark"] .card,html[data-theme="dark"] .stat-card,html[data-theme="dark"] .content-card,html[data-theme="dark"] .dashboard-card,html[data-theme="dark"] .chart-container,html[data-theme="dark"] .status-card,html[data-theme="dark"] .table-container,html[data-theme="dark"] .modal-content,html[data-theme="dark"] .dropdown-menu{background:var(--farm-surface)!important;color:var(--farm-text)!important;border-color:var(--farm-border)!important;box-shadow:var(--farm-shadow)}
html[data-theme="dark"] h1,html[data-theme="dark"] h2,html[data-theme="dark"] h3,html[data-theme="dark"] h4,html[data-theme="dark"] label,html[data-theme="dark"] td,html[data-theme="dark"] th{color:var(--farm-text)}
html[data-theme="dark"] p,html[data-theme="dark"] small,html[data-theme="dark"] .text-muted,html[data-theme="dark"] .subtitle{color:var(--farm-muted)}
html[data-theme="dark"] input,html[data-theme="dark"] select,html[data-theme="dark"] textarea{background:#071a32!important;color:var(--farm-text)!important;border-color:var(--farm-border)!important}
html[data-theme="dark"] body::before{content:"🌙  🐔  ✦  🌾";position:fixed;right:22px;bottom:12px;z-index:0;opacity:.22;font-size:26px;pointer-events:none}
.theme-toggle{display:flex;align-items:center;justify-content:space-between;gap:10px;width:calc(100% - 24px);margin:12px;padding:10px 12px;border:1px solid rgba(120,160,210,.35);border-radius:12px;color:inherit;background:rgba(80,140,210,.12);font:inherit;font-size:13px;cursor:pointer;transition:transform .18s ease,background .18s ease}.theme-toggle:hover{transform:translateY(-1px);background:rgba(30,130,235,.2)}.theme-toggle-label{font-weight:650}.theme-toggle-state{opacity:.8;font-size:12px}.theme-toggle:focus-visible{outline:3px solid #48a5ff;outline-offset:3px}
